# ============================================================
# MiniURL 环境变量模板
#
# 用法：
#   cp .env.example .env      # 复制后按下面说明填入真实值
#
# .env 已被 .gitignore 忽略，不会入库。
# docker compose 会自动读取与 docker-compose.yml 同目录的 .env。
# 本地直接用 JVM 跑（./mvnw spring-boot:run）时也需要，可用
#   export $(grep -v '^#' .env | xargs)     # Linux/macOS
# 或直接在 IDE 的 Run Configuration 里配环境变量。
# ============================================================

# ---------- MySQL / Redis 口令 ----------
# 本地开发保持 root 即可（与 application.yml 的默认值一致）；
# 生产环境务必改成强口令。
MYSQL_PASSWORD=root
REDIS_PASSWORD=root

# ---------- Grafana 管理台口令 ----------
GRAFANA_PASSWORD=admin

# ---------- JWT 签名密钥（必填） ----------
# HS256 要求密钥至少 256 位（32 字节）。生成方式：
#   openssl rand -base64 48
#   PowerShell: [Convert]::ToBase64String((1..48 | ForEach-Object { Get-Random -Max 256 }))
#
# ⚠️ 这个值一旦泄露，任何人都能伪造任意用户的 token 直接登录任意账号。
#    docker compose 栈未设置此项会直接启动失败——这是刻意设计，
#    避免生产环境静默沿用 application.yml 里那个已随仓库公开的开发默认值。
JWT_SECRET=

# ---------- 短链对外地址（可选） ----------
# 局域网 / 手机访问时填宿主机 IP，短链会拼成 http://192.168.x.x/s/xxx；
# 不设置则回退 localhost（本机访问）。
# MINIURL_LAN_IP=192.168.100.3
