    {
      "name": "07-302跳转",
      "description": "短链跳转，公开接口无需鉴权",
      "item": [
        {
          "name": "[TC-20] 302跳转正常",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "// 创建一条新短链用于跳转测试",
                  "var createReq = {",
                  "  url: pm.collectionVariables.get('baseUrl') + '/api/link/create',",
                  "  method: 'POST',",
                  "  header: {",
                  "    'Content-Type': 'application/json',",
                  "    'Authorization': 'Bearer ' + pm.collectionVariables.get('token')",
                  "  },",
                  "  body: { mode: 'raw', raw: JSON.stringify({longUrl: 'https://www.baidu.com'}) }",
                  "};",
                  "",
                  "pm.sendRequest(createReq, function (err, res) {",
                  "    if (err) { pm.expect.fail('创建测试短链失败: ' + err); return; }",
                  "    var code = res.json().data.shortCode;",
                  "    // 访问短链，禁止自动重定向",
                  "    pm.sendRequest({",
                  "        url: pm.collectionVariables.get('baseUrl') + '/s/' + code,",
                  "        method: 'GET',",
                  "        followRedirects: false",
                  "    }, function (err2, res2) {",
                  "        if (err2) { pm.expect.fail('跳转请求失败: ' + err2); return; }",
                  "        pm.test('跳转应返回 302, Location指向百度', function () {",
                  "            pm.expect(res2.code).to.eql(302);",
                  "            pm.expect(res2.headers.location).to.eql('https://www.baidu.com');",
                  "        });",
                  "    });",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/s/{{shortCode}}",
              "host": ["{{baseUrl}}"],
              "path": ["s", "{{shortCode}}"],
              "description": "⚠️ 此用例由 test script 动态创建短链并验证 302，直接点 Send 无意义。正确用法是看 folder 级别 Runner 中不会跳过。"
            }
          }
        },
