    {
      "name": "01-准备：清理与注册",
      "description": "创建测试用户并获取 token，为后续所有用例提供认证凭据",
      "item": [
        {
          "name": "注册测试用户",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('注册成功或用户名已存在', function () {",
                  "    pm.expect(pm.response.json().code).to.be.oneOf([20000, 41100]);",
                  "});",
                  "// 保存用户名供后续使用",
                  "pm.collectionVariables.set('testUsername', 'regression_test_user');"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"username\": \"{{testUsername}}\",\n  \"password\": \"123456\"\n}"
            },
            "url": { "raw": "{{baseUrl}}/api/user/register", "host": ["{{baseUrl}}"], "path": ["api", "user", "register"] }
          }
        },
        {
          "name": "登录获取 Token",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('登录成功，返回 token', function () {",
                  "    var json = pm.response.json();",
                  "    pm.expect(json.code).to.eql(20000);",
                  "    pm.expect(json.data.token).to.be.a('string');",
                  "    // 存储 token 到集合变量，后续所有请求自动携带",
                  "    pm.collectionVariables.set('token', json.data.token);",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"username\": \"{{testUsername}}\",\n  \"password\": \"123456\"\n}"
            },
            "url": { "raw": "{{baseUrl}}/api/user/login", "host": ["{{baseUrl}}"], "path": ["api", "user", "login"] }
          }
        }
      ]
